---
/* Yangtso now lives on the home page. Old links to /test/yangtso/ (some reviewers have them)
   are sent there, keeping any #section in the address. */
import { paths } from '../../foundry/config.js';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Yangtso · Terma Foundry</title>
    <meta http-equiv="refresh" content={`0; url=${paths.home}`} />
    <link rel="canonical" href={paths.home} />
    <script is:inline define:vars={{ home: paths.home }}>
      location.replace(home + location.hash);
    </script>
  </head>
  <body>
    <p>Yangtso has moved to the <a href={paths.home}>Terma Foundry home page</a>.</p>
  </body>
</html>
