---
import Site from '../../foundry/layouts/Site.astro';
import '../../foundry/styles/studio.css';
import { paths, BUILD } from '../../foundry/config.js';
import { FONTS, TEXT, SAMPLES } from '../../foundry/data/fonts.js';

const vowels = [
  ['ka', 'ཀ'], ['ki', 'ཀི'], ['ku', 'ཀུ'], ['ke', 'ཀེ'], ['ko', 'ཀོ'],
  ['kA', 'ཀཱ'], ['kI', 'ཀཱི'], ['kU', 'ཀཱུ'], ['kai', 'ཀཻ'], ['kau', 'ཀཽ'], ['k-i', 'ཀྀ'],
];
const sanskrit = [
  ['T', 'ཊ'], ['Th', 'ཋ'], ['D', 'ཌ'], ['N', 'ཎ'], ['Sh', 'ཥ'], ['kaM', 'ཀཾ'], ['kaH', 'ཀཿ'], ['ka~M', 'ཀྃ'],
];
const punct = [
  ['space', '་', 'tsheg'], ['/', '།', 'shad'], ['//', '༎', 'double shad'], ['_', '␣', 'a real space'], ['*', '༌', 'non-breaking tsheg'],
  ['@#', '༄༅', 'yig mgo'], ['!', '༈', 'sbrul shad'], [';', '༏', 'gter shad'], ['0…9', '༠…༩', 'digits'],
];
const stacking = [
  ['pad+ma', 'པདྨ', 'explicit stack with +'], ['pad ma', 'པད་མ', 'two syllables'], ['g.yag', 'གཡག', 'prefix g, root ya'], ['gyag', 'གྱག', 'ga with ya-btags'],
];
---

<Site title="Writing Studio" chrome={false} bodyClass="page-studio" preload={['yangtso-regular.woff2', 'pema-regular.woff2']}>
  <div class="studio" id="studio" data-layout="tibetan" data-theme="light" data-font="yangtso" data-drawer="open" data-focus="false">
    <!-- ═══════════ Top bar ═══════════ -->
    <header class="sb">
      <button class="sbtn sbtn--icon" type="button" data-drawer-toggle aria-expanded="true" aria-label="Documents">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M9 4v16" /></svg>
      </button>
      <a class="sb__brand" href={paths.home} title="Terma Foundry">
        <span class="wordmark__mark" aria-hidden="true"></span>
        <span>Terma <em>Foundry</em></span>
      </a>
      <input class="sb__title" type="text" data-title aria-label="Document title" placeholder="Untitled" spellcheck="false" autocomplete="off" />

      <div class="sb__group">
        <div class="seg" role="group" aria-label="Font">
          {Object.values(FONTS).map((f) => <button type="button" class="seg__btn" data-font-btn={f.id} aria-pressed={f.id === 'yangtso' ? 'true' : 'false'}>{f.name}</button>)}
        </div>
        <div class="seg" role="group" aria-label="Weight">
          <button type="button" class="seg__btn" data-weight-btn="300" aria-pressed="false">Light</button>
          <button type="button" class="seg__btn" data-weight-btn="400" aria-pressed="true">Regular</button>
          <button type="button" class="seg__btn" data-weight-btn="700" aria-pressed="false">Bold</button>
        </div>
      </div>
      <span class="sb__sep" aria-hidden="true"></span>
      <label class="sb__size">
        <span>Font size <output data-pref-size-out>34 px</output></span>
        <input type="range" min="18" max="120" step="1" value="34" data-pref-size aria-label="Font size" />
      </label>
      <span class="sb__sep" aria-hidden="true"></span>
      <div class="seg" role="group" aria-label="Layout">
        <button type="button" class="seg__btn" data-layout-btn="tibetan" aria-pressed="true" title="Only the Tibetan, converted as you type">Tibetan only</button>
        <button type="button" class="seg__btn" data-layout-btn="split" aria-pressed="false" title="Your Wylie on the left, the Tibetan on the right">Wylie + Tibetan</button>
        <button type="button" class="seg__btn" data-layout-btn="inline" aria-pressed="false" title="The Tibetan above each line of Wylie">Line by line</button>
      </div>
      <select class="ssel" data-theme-sel aria-label="Background">
        <option value="">Background: auto</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
        <option value="paper">Paper</option>
        <option value="ink">Ink</option>
        <option value="lamp">Lamp-lit</option>
      </select>

      <div class="sb__right">
        <span class="sb__saved" data-saved>Autosaves in this browser</span>
        <div class="pop-anchor">
          <button class="sbtn sbtn--outline" type="button" data-pop-btn="settings" aria-expanded="false" aria-haspopup="true">Text settings</button>
          <div class="pop pop--wide" data-pop="settings" hidden>
            <div class="pop__head">Text</div>
            <label class="pop__row">
              <span>Line spacing <output data-pref-leading-out>2.00</output></span>
              <input type="range" min="1.6" max="3.4" step="0.05" value="2" data-pref-leading />
            </label>
            <div class="pop__row">
              <span>Text width</span>
              <div class="seg">
                <button type="button" class="seg__btn" data-pref-width="narrow">Narrow</button>
                <button type="button" class="seg__btn" data-pref-width="medium" aria-pressed="true">Medium</button>
                <button type="button" class="seg__btn" data-pref-width="wide">Wide</button>
                <button type="button" class="seg__btn" data-pref-width="full">Full</button>
              </div>
            </div>
            <div class="pop__sep"></div>
            <div class="pop__head">Help while typing</div>
            <label class="pop__toggle"><span>Show the Wylie under the syllable I am typing</span><input type="checkbox" data-pref-toggle="hints" checked /></label>
            <label class="pop__toggle"><span>Underline Wylie that does not make a valid syllable</span><input type="checkbox" data-pref-toggle="warn" checked /></label>
            <label class="pop__toggle"><span>Mark characters this font does not have yet</span><input type="checkbox" data-pref-toggle="coverage" checked /></label>
          </div>
        </div>
        <div class="pop-anchor">
          <button class="sbtn sbtn--primary" type="button" data-pop-btn="export" aria-expanded="false" aria-haspopup="true">
            Copy / Download
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M4 19h16" /></svg>
          </button>
          <div class="pop" data-pop="export" hidden>
            <div class="pop__head">Copy to the clipboard</div>
            <button type="button" class="pop__item" data-action="copy-bo">Copy the Tibetan text</button>
            <button type="button" class="pop__item" data-action="copy-wy">Copy the Wylie</button>
            <div class="pop__sep"></div>
            <div class="pop__head">Download a file</div>
            <button type="button" class="pop__item" data-action="dl-bo">Tibetan text <small>.txt</small></button>
            <button type="button" class="pop__item" data-action="dl-wy">Wylie text <small>.txt</small></button>
            <button type="button" class="pop__item" data-action="dl-both">Both together <small>.txt</small></button>
            <button type="button" class="pop__item" data-action="png">Picture of the text <small>.png</small></button>
            <button type="button" class="pop__item" data-action="print">Print, or save as PDF</button>
            <div class="pop__sep"></div>
            <div class="pop__head">Change what I typed into</div>
            <button type="button" class="pop__item" data-action="src-wy">Wylie</button>
            <button type="button" class="pop__item" data-action="src-bo">Tibetan</button>
          </div>
        </div>
        <button class="sbtn sbtn--outline" type="button" data-panel-btn="help" aria-label="Help, Wylie cheat sheet and review notes">Help</button>
      </div>
    </header>

    <!-- ═══════════ Body ═══════════ -->
    <div class="sbody">
      <aside class="drawer" aria-label="Documents">
        <div class="drawer__head">
          <span>Documents</span>
          <button type="button" class="sbtn" data-new-doc>+ New</button>
        </div>
        <div class="drawer__samples">
          {Object.values(SAMPLES).map((s) => (
            <button type="button" class="sample" data-sample={s.id.replace('sample-', '')}>
              <strong>Load: {s.label}</strong>
              <span>{s.note}</span>
            </button>
          ))}
        </div>
        <div class="docs" data-docs role="list"></div>
        <div class="drawer__foot">
          Documents are saved in this browser only, on this device. Nothing is sent anywhere. Export what you want to keep.
        </div>
      </aside>
      <div class="scrim" data-scrim></div>

      <div class="ed" data-ed data-layout="tibetan">
        <textarea class="ed__ta" data-ta aria-label="Wylie or Tibetan source" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" placeholder="bkra shis bde legs/"></textarea>
        <div class="ed__mirror" data-mirror aria-label="Tibetan rendering">
          <div class="ed__col" data-col lang="bo"></div>
        </div>
      </div>
    </div>

    <!-- ═══════════ Status bar ═══════════ -->
    <footer class="st">
      <span><strong data-stat-syl>0</strong> syllables</span>
      <span class="st__hide-sm"><strong data-stat-shad>0</strong> shad</span>
      <span class="st__hide-sm"><strong data-stat-chars>0</strong> characters</span>
      <span>reading time <strong data-stat-read>0 min</strong></span>
      <span data-stat-bad-wrap hidden><button type="button"><strong data-stat-bad>0</strong> Wylie problems (click to jump)</button></span>
      <span class="st__spacer"></span>
      <span class="st__review">Review build v{BUILD.version} · fonts are unreleased</span>
      <button type="button" data-panel-btn="help" class="st__hide-sm">Wylie help</button>
    </footer>

    <!-- ═══════════ Help / review notes ═══════════ -->
    <aside class="panel" data-panel="help" data-open="false" aria-label="Help and review notes">
      <div class="panel__head">
        <h2>How this studio works</h2>
        <button type="button" class="sbtn sbtn--icon" data-panel-close aria-label="Close">×</button>
      </div>
      <p>
        This is a <strong>review tool</strong>. Yangtso and Pema are unreleased typefaces, exported on {BUILD.dateHuman} as
        {BUILD.label.toLowerCase()}, and shared with a few reviewers. Type or paste anything, look closely, and send what you find
        to Thupten Chakrishar by replying to the message that brought you here.
      </p>

      <h3>What to look for</h3>
      <ul>
        <li>Letterforms that read wrong, or are hard to tell apart.</li>
        <li>Stacks that sit too high, too low, or too tight; vowel signs out of place.</li>
        <li>Spacing between letters and syllables; the size of the tsheg and shad.</li>
        <li>Whether Light, Regular and Bold feel like one family.</li>
        <li>Anything marked with a dashed box: a character this build does not contain.</li>
      </ul>

      <h3>Typing</h3>
      <ul>
        <li>Type <strong>Wylie</strong> and it becomes Tibetan as you go. A space makes a tsheg; <code>/</code> makes a shad; a space after a shad stays a space.</li>
        <li>Or <strong>paste Tibetan text</strong> (<code>Ctrl V</code>, or <code>⌘ V</code> on a Mac). Wylie and Tibetan can live in one document.</li>
        <li>The <strong>Font size</strong> slider is in the bar at the top. <strong>Line spacing</strong> and <strong>Text width</strong> are under "Text settings".</li>
        <li>A wavy red underline means a syllable is not valid Wylie. Hover it to read why. It never stops you typing.</li>
        <li>Views: <strong>Tibetan only</strong> shows just the Tibetan, with the Wylie of the syllable you are on underneath it; <strong>Wylie + Tibetan</strong> puts your Wylie on the left; <strong>Line by line</strong> puts the Wylie under each line.</li>
        <li>Undo, redo, select-all and the arrow keys work as they do in any text box. It saves by itself.</li>
      </ul>

      <h3>Consonants</h3>
      <div class="cheat">
        {TEXT.letters.map((l, i) => (
          <div class="cheat__cell"><span lang="bo">{l}</span><small>{TEXT.lettersWylie[i]}</small></div>
        ))}
      </div>

      <h3>Vowels</h3>
      <div class="cheat">
        {vowels.map(([w, u]) => (
          <div class="cheat__cell"><span lang="bo">{u}</span><small>{w}</small></div>
        ))}
      </div>

      <h3>Sanskrit letters and marks</h3>
      <div class="cheat">
        {sanskrit.map(([w, u]) => (
          <div class="cheat__cell"><span lang="bo">{u}</span><small>{w}</small></div>
        ))}
      </div>

      <h3>Stacks</h3>
      <div class="kv">
        {stacking.map(([w, u, n]) => (
          <>
            <code>{w}</code>
            <div><span lang="bo">{u}</span> <small class="muted">· {n}</small></div>
          </>
        ))}
      </div>

      <h3>Punctuation and digits</h3>
      <div class="kv">
        {punct.map(([w, u, n]) => (
          <>
            <code>{w}</code>
            <div><span lang="bo">{u}</span> <small class="muted">· {n}</small></div>
          </>
        ))}
      </div>

      <h3>What this build contains</h3>
      <p>
        Everyday Tibetan and the common mantras: 847 glyphs, 555 precomposed stacks, covering 99.75% of a 134-million-syllable
        corpus. The rare Sanskrit stacks of the pecha are left out on purpose. Characters this build lacks are shown by a fallback
        font and marked with a dashed box.
      </p>

      <h3>Privacy</h3>
      <p>Everything you write stays in this browser's storage. Nothing is uploaded. Export a copy of anything you want to keep.</p>
    </aside>

    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <div class="visually-hidden" data-live aria-live="polite"></div>
  </div>
</Site>

<script>
  import { initStudio } from '../../foundry/lib/studio.js';
  const root = document.getElementById('studio');
  if (root) initStudio(root);
</script>

<style is:global>
  body.page-studio {
    overflow: hidden;
  }
  body.page-studio main {
    display: block;
  }
</style>
