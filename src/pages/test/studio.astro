---
import Site from '../../foundry/layouts/Site.astro';
import '../../foundry/styles/studio.css';
import { paths, BUILD } from '../../foundry/config.js';
import { FONT_LIST } from '../../foundry/data/fonts.js';
---

<Site title="Writing Studio" chrome={false} bodyClass="page-studio" preload={['yangtso-regular.woff2']}>
  <div class="studio" id="studio" data-layout="tibetan" data-font="yangtso" data-focus="false">
    <!-- ═══════════ Top bar ═══════════ -->
    <header class="sb">
      <a class="sb__brand" href={paths.home} title="Terma Foundry">
        <span class="wordmark__mark" aria-hidden="true"></span>
        <span>Terma <em>Foundry</em></span>
      </a>

      <div class="sb__group">
        {FONT_LIST.length > 1 && (
          <div class="seg" role="group" aria-label="Font">
            {FONT_LIST.map((f) => <button type="button" class="seg__btn" data-font-btn={f.id} aria-pressed={f.id === 'yangtso' ? 'true' : 'false'}>{f.name}</button>)}
          </div>
        )}
        <div class="seg" role="group" aria-label="Weight">
          <button type="button" class="seg__btn" data-weight-btn="300" aria-pressed="false">Light</button>
          <button type="button" class="seg__btn" data-weight-btn="400" aria-pressed="true">Regular</button>
          <button type="button" class="seg__btn" data-weight-btn="700" aria-pressed="false">Bold</button>
        </div>
      </div>
      <span class="sb__sep" aria-hidden="true"></span>
      <label class="sb__size">
        <span>Font size <output data-pref-size-out>34 px</output></span>
        <input type="range" min="18" max="120" step="1" value="34" data-pref-size aria-label="Font size" />
      </label>

      <div class="sb__right">
        <span class="sb__saved" data-saved>Autosaves in this browser</span>
        <button class="sbtn sbtn--primary" type="button" data-sample="mixed">Load mixed language</button>
      </div>
    </header>

    <!-- ═══════════ Body ═══════════ -->
    <div class="sbody">
      <div class="ed" data-ed data-layout="tibetan">
        <textarea class="ed__ta" data-ta aria-label="Type Wylie, or paste Tibetan" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" placeholder="bkra shis bde legs/"></textarea>
        <div class="ed__mirror" data-mirror aria-label="Tibetan rendering">
          <div class="ed__col" data-col lang="bo"></div>
        </div>
      </div>
    </div>

    <!-- ═══════════ Status bar ═══════════ -->
    <footer class="st">
      <span><strong data-stat-syl>0</strong> syllables</span>
      <span class="st__hide-sm"><strong data-stat-shad>0</strong> shad</span>
      <span class="st__hide-sm"><strong data-stat-chars>0</strong> characters</span>
      <span>reading time <strong data-stat-read>0 min</strong></span>
      <span data-stat-bad-wrap hidden><button type="button"><strong data-stat-bad>0</strong> Wylie problems (click to jump)</button></span>
      <span class="st__spacer"></span>
      <span class="st__review">Review build v{BUILD.version} · Yangtso is not released yet</span>
    </footer>

    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <div class="visually-hidden" data-live aria-live="polite"></div>
  </div>
</Site>

<script>
  import { initStudio } from '../../foundry/lib/studio.js';
  const root = document.getElementById('studio');
  if (root) initStudio(root);
</script>

<style is:global>
  body.page-studio {
    overflow: hidden;
  }
  body.page-studio main {
    display: block;
  }
</style>
